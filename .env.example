# Copy this file to .env and fill in your Supabase project credentials.
# Get these from: https://supabase.com/dashboard → Project Settings → API

# Your Supabase project URL (e.g. https://xyzabc.supabase.co)
SUPABASE_URL=

# Your Supabase project anon/public key (safe to expose in browser)
SUPABASE_ANON_KEY=

# Anthropic API key — used server-side only by api/shade-analyze.js
# Get yours at: https://console.anthropic.com/settings/keys
# If unset the shade picker returns demo data instead of calling Claude.
ANTHROPIC_API_KEY=

# Profile credentials — two pre-configured test accounts for the profile picker.
# Profile A = Doctor (dentist view), Profile B = Technician (lab view).
# If unset, the profile picker still works but shows empty data.
PROFILE_A_EMAIL=
PROFILE_A_PASSWORD=
PROFILE_B_EMAIL=
PROFILE_B_PASSWORD=
