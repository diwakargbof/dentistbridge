# Chairside — environment variables
# Copy to .env and fill in your credentials.

# ── Supabase ──────────────────────────────────────────────────
# Project URL: Supabase Dashboard → Project Settings → API
SUPABASE_URL=

# Anon/public key (safe for browser — used for Realtime subscriptions)
SUPABASE_ANON_KEY=

# Service role key (server-side only — DO NOT expose to browser)
# Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_KEY=

# ── Anthropic ─────────────────────────────────────────────────
# Used server-side for AI shade analysis (POST /api/shade)
# https://console.anthropic.com/settings/keys
# Leave blank to return demo shade data instead of calling Claude.
ANTHROPIC_API_KEY=

# ── Phone login profiles ──────────────────────────────────────
# Map the two static phone numbers to real Supabase user UUIDs.
# Once you create users in Supabase, paste their UUIDs here.
# Until then the app works but Supabase queries will return empty results.
PROFILE_A_ID=static-dent-anaya
PROFILE_A_NAME=Dr. Anaya Rao
PROFILE_A_CITY=Mumbai

PROFILE_B_ID=static-tech-vikram
PROFILE_B_NAME=Vikram Iyer
PROFILE_B_CITY=Mumbai

# 8919744177 → dentist (PROFILE_A)
# 9440134493 → technician (PROFILE_B)

# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
