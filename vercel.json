{
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/**", "src/**"]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)",  "dest": "server/index.js" },
    { "src": "/config.js", "dest": "server/index.js" },
    { "src": "/(.*)",      "dest": "server/index.js" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
